# ─────────────────────────────────────────────────────────────────────────────
# 8x-hack monorepo — attributes
#
# Git resolves attributes by LAST MATCH WINS, per attribute — there is no
# specificity rule. So the file is ordered deliberately:
#
#   1. line endings   2. Git LFS   3. LFS opt-outs   4. review hygiene
#   5. design mirror  ← LAST, so nothing above can re-normalise it
#
# Inside block 5 the blanket rule comes first and the binary overrides after,
# for the same reason.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Line endings ──────────────────────────────────────────────────────────
* text=auto eol=lf

*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.pbxproj   -text

# SVG and Lottie are text — keep them diffable, never LFS.
*.svg       text diff
*.dart      text diff=dart
*.sql       text diff=sql

# ── 2. Git LFS ───────────────────────────────────────────────────────────────
# Source design formats
*.psd       filter=lfs diff=lfs merge=lfs -text
*.psb       filter=lfs diff=lfs merge=lfs -text
*.ai        filter=lfs diff=lfs merge=lfs -text
*.sketch    filter=lfs diff=lfs merge=lfs -text
*.fig       filter=lfs diff=lfs merge=lfs -text
*.xd        filter=lfs diff=lfs merge=lfs -text
*.afdesign  filter=lfs diff=lfs merge=lfs -text
*.afphoto   filter=lfs diff=lfs merge=lfs -text
*.xcf       filter=lfs diff=lfs merge=lfs -text

# Video
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.mov       filter=lfs diff=lfs merge=lfs -text
*.m4v       filter=lfs diff=lfs merge=lfs -text
*.webm      filter=lfs diff=lfs merge=lfs -text
*.avi       filter=lfs diff=lfs merge=lfs -text
*.mkv       filter=lfs diff=lfs merge=lfs -text

# Audio
*.wav       filter=lfs diff=lfs merge=lfs -text
*.mp3       filter=lfs diff=lfs merge=lfs -text
*.m4a       filter=lfs diff=lfs merge=lfs -text
*.aac       filter=lfs diff=lfs merge=lfs -text
*.flac      filter=lfs diff=lfs merge=lfs -text
*.ogg       filter=lfs diff=lfs merge=lfs -text

# Fonts
*.ttf       filter=lfs diff=lfs merge=lfs -text
*.otf       filter=lfs diff=lfs merge=lfs -text
*.woff      filter=lfs diff=lfs merge=lfs -text
*.woff2     filter=lfs diff=lfs merge=lfs -text
*.eot       filter=lfs diff=lfs merge=lfs -text

# 3D / rich animation
*.glb       filter=lfs diff=lfs merge=lfs -text
*.gltf      filter=lfs diff=lfs merge=lfs -text
*.usdz      filter=lfs diff=lfs merge=lfs -text
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.riv       filter=lfs diff=lfs merge=lfs -text

# Archives, documents, shipped app bundles
*.zip       filter=lfs diff=lfs merge=lfs -text
*.7z        filter=lfs diff=lfs merge=lfs -text
*.rar       filter=lfs diff=lfs merge=lfs -text
*.gz        filter=lfs diff=lfs merge=lfs -text
*.tgz       filter=lfs diff=lfs merge=lfs -text
*.bz2       filter=lfs diff=lfs merge=lfs -text
*.xz        filter=lfs diff=lfs merge=lfs -text
*.pdf       filter=lfs diff=lfs merge=lfs -text
*.ipa       filter=lfs diff=lfs merge=lfs -text
*.apk       filter=lfs diff=lfs merge=lfs -text
*.aab       filter=lfs diff=lfs merge=lfs -text
*.aar       filter=lfs diff=lfs merge=lfs -text

# Raster images — *scoped*, not global.
# Only content directories go to LFS. Platform launcher icons under
# app/android/ and app/ios/ deliberately stay ordinary Git blobs so a clone
# on a machine without git-lfs still builds.
design/**/*.png     filter=lfs diff=lfs merge=lfs -text
design/**/*.jpg     filter=lfs diff=lfs merge=lfs -text
design/**/*.jpeg    filter=lfs diff=lfs merge=lfs -text
design/**/*.gif     filter=lfs diff=lfs merge=lfs -text
design/**/*.webp    filter=lfs diff=lfs merge=lfs -text
design/**/*.avif    filter=lfs diff=lfs merge=lfs -text
design/**/*.heic    filter=lfs diff=lfs merge=lfs -text
design/**/*.tif     filter=lfs diff=lfs merge=lfs -text
design/**/*.tiff    filter=lfs diff=lfs merge=lfs -text
design/**/*.bmp     filter=lfs diff=lfs merge=lfs -text
design/**/*.ico     filter=lfs diff=lfs merge=lfs -text

app/assets/**/*.png     filter=lfs diff=lfs merge=lfs -text
app/assets/**/*.jpg     filter=lfs diff=lfs merge=lfs -text
app/assets/**/*.jpeg    filter=lfs diff=lfs merge=lfs -text
app/assets/**/*.gif     filter=lfs diff=lfs merge=lfs -text
app/assets/**/*.webp    filter=lfs diff=lfs merge=lfs -text
app/assets/**/*.avif    filter=lfs diff=lfs merge=lfs -text

docs/assets/**/*.png    filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.jpg    filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.jpeg   filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.gif    filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.webp   filter=lfs diff=lfs merge=lfs -text

# ── 3. LFS opt-outs ──────────────────────────────────────────────────────────
# Small, build-critical binaries that must survive a non-LFS clone.
app/android/gradle/wrapper/gradle-wrapper.jar   -filter -diff -merge binary
**/*.xcassets/**                                -filter -diff -merge

# ── 4. Review hygiene ────────────────────────────────────────────────────────
pubspec.lock            linguist-generated=true
supabase/config.toml    linguist-language=TOML

# ── 5. Design mirror — MUST STAY LAST ────────────────────────────────────────
# design/files/ is a byte-for-byte mirror of a Claude Design project root.
# `-text` disables *all* normalisation: if Git rewrote one CRLF, the byte-size
# check in `/design:pull` would disagree with the remote and every later push
# would look like a phantom edit. `diff` forces Git to still treat them as text
# so reviews stay readable despite `-text`.
design/files/**                 -text diff
design/files/**                 linguist-detectable=false
design/files/**/*.dc.html       linguist-language=HTML
design/files/**/support.js      linguist-generated=true

# Binaries that land inside the mirror still belong in LFS. These come after
# the blanket rule above so they win for their extensions only.
design/files/**/*.png   filter=lfs diff=lfs merge=lfs -text
design/files/**/*.jpg   filter=lfs diff=lfs merge=lfs -text
design/files/**/*.jpeg  filter=lfs diff=lfs merge=lfs -text
design/files/**/*.gif   filter=lfs diff=lfs merge=lfs -text
design/files/**/*.webp  filter=lfs diff=lfs merge=lfs -text
design/files/**/*.avif  filter=lfs diff=lfs merge=lfs -text
design/files/**/*.mp4   filter=lfs diff=lfs merge=lfs -text
design/files/**/*.woff2 filter=lfs diff=lfs merge=lfs -text
design/files/**/*.ttf   filter=lfs diff=lfs merge=lfs -text
design/files/**/*.otf   filter=lfs diff=lfs merge=lfs -text
