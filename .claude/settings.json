{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git config user.name)",
      "Bash(git lfs status)",
      "Bash(git lfs ls-files:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub add:*)",
      "Bash(flutter pub outdated:*)",
      "Bash(dart format:*)",
      "Bash(dart fix:*)",
      "Bash(supabase status:*)",
      "Bash(supabase db diff:*)",
      "Bash(supabase db lint:*)",
      "Bash(supabase migration list:*)",
      "Bash(supabase gen types:*)",
      "mcp__claude-design__list_projects",
      "mcp__claude-design__get_project",
      "mcp__claude-design__list_files",
      "mcp__claude-design__read_file",
      "mcp__claude-design__list_comments",
      "mcp__claude-design__render_preview"
    ],
    "ask": [
      "mcp__claude-design__write_files",
      "mcp__claude-design__delete_files",
      "mcp__claude-design__copy_files",
      "mcp__claude-design__create_project",
      "mcp__claude-design__update_sharing",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase functions deploy:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.local.json)",
      "Read(./app/android/key.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)"
    ]
  }
}
