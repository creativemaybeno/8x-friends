# ─────────────────────────────────────────────────────────────────────────────
# 8x-hack monorepo — root ignore rules
#
# Sub-packages carry their own .gitignore (app/, app/android/, app/ios/,
# supabase/). This file covers cross-cutting noise plus everything the design
# sync produces locally. Overlap with the nested files is deliberate: the repo
# stays safe even if a generated .gitignore is regenerated or deleted.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & local environment ──────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.local.json
!*.local.example.json
secrets/
*.pem
*.p12
*.p8
*.mobileprovision
*.jks
*.keystore
key.properties

# ── Design sync working state ────────────────────────────────────────────────
# Per-Claude-Design-project etags/hashes. Local by definition: each of us
# pushes to a *different* project, so these must never be shared.
design/.sync/
# Raw entity-escaped payloads staged mid-pull, before decode + size check.
design/.staging/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
Icon?

# ── Editors & IDEs ───────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
.history/
.fleet/
.zed/
*.sublime-workspace

# ── Claude Code ──────────────────────────────────────────────────────────────
# .claude/ itself is committed (shared commands + settings). Only per-user
# state is ignored.
.claude/settings.local.json
.claude/.credentials.json
.claude/shell-snapshots/
.claude/todos/
.claude/statsig/

# ── Flutter / Dart ───────────────────────────────────────────────────────────
# Real --dart-define values. app/dart_define.example.json is the committed template.
app/dart_define.json
.dart_tool/
.packages
.pub-cache/
.pub/
build/
**/doc/api/
.flutter-plugins
.flutter-plugins-dependencies
**/ios/Flutter/.last_build_id
coverage/
*.class
migrate_working_dir/
app.*.symbols
app.*.map.json

# ── Android ──────────────────────────────────────────────────────────────────
.gradle/
captures/
local.properties
gradle-wrapper.jar
gradlew
gradlew.bat
GeneratedPluginRegistrant.java
.cxx/

# ── iOS / macOS (Xcode) ──────────────────────────────────────────────────────
**/Pods/
**/.symlinks/
**/DerivedData/
xcuserdata/
*.xcworkspace/xcuserdata/
**/Flutter/App.framework
**/Flutter/Flutter.framework
**/Flutter/Flutter.podspec
**/Flutter/Generated.xcconfig
**/Flutter/ephemeral/
**/Flutter/flutter_export_environment.sh
ServiceDefinitions.json
*.mode1v3
*.mode2v3
*.perspectivev3
*.pbxuser
!default.pbxuser

# ── Supabase ─────────────────────────────────────────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/logs/

# ── Node / Deno (edge functions, tooling) ────────────────────────────────────
node_modules/
.deno/
deno.lock.bak
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ── Misc build & log output ──────────────────────────────────────────────────
*.log
dist/
out/
tmp/
.cache/
